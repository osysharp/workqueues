namespace Osysharp.WorkQueues;

using Osysharp.Identity;
using Osysharp.Workflow;

// ── escalation: up a level, and what a promise does when it is at risk or breached ──────────────────────────────────
//
// A queue has a `Level` (L1 = 1, L2 = 2, L3 = 3) and may name the queue it `EscalatesTo`. `EscalateWork(item, why)`
// moves the item there and raises its level: the promise is read again (a policy may be keyed by queue), the clocks are
// retargeted keeping the time used, and the item is routed again at the new level — its holder keeps it only when they
// are a member there (and `InboxSetup.KeepHolderOnEscalation`). Every escalation is an `Escalation` row and an
// `Handover` with reason `Escalated`.
//
// A policy's `SlaEscalation` rows say what its clocks DO when they go at risk or are breached — a CLOSED set: tell the
// holder, tell the leads, raise the priority one step, escalate, move to a queue. Each fires once per clock cycle (the
// first response; each next response; the resolution), because the moment itself is recorded once on the clock.
// Anything richer — post in a channel, set a tag — is an automation's, not the inbox's.

/// One change of level: from where, to where, why, and — when a clock did it — which promise.
public entity Escalation {
  [Required] WorkItem Item;
  int FromLevel;
  int ToLevel;
  Queue? FromQueue;
  Queue? ToQueue;
  /// Who escalated it — none: a promise did (an `SlaEscalation`).
  Principal? By;
  /// Why, in the words of whoever escalated it — "" when a promise did (`Metric`, `Moment` say which).
  [MaxLength(300)] string Why = "";
  /// The promise whose moment escalated it, and the moment, when one did.
  SlaMetric? Metric;
  SlaMoment? Moment;
  DateTime At;
  // SECURITY-INVARIANT(inbox-service-internals-are-staffs) — the requester's side reads no escalation history.
  security { allow read when WorksInbox; }
}

/// Escalate `item` to the next level — the queue its queue `EscalatesTo` — saying `why`. The team's (`WorksInbox`).
public void EscalateWork(WorkItem item, string why) { WorkHandling.RaiseEscalate(item, why); }

/// Move `item` up a level. `by`: who did it (none: a promise). `metric`, `moment`: the promise that did it, if one did.
void LevelUp(WorkItem item, Principal? by, string why, SlaMetric? metric, SlaMoment? moment = null) {
  var from = item.Queue;
  if (from == null || from.EscalatesTo == null) {
    throw new ValidationException((from == null ? "It" : from.Name) + " has no next level to escalate to.");
  }
  var to = from.EscalatesTo!;
  if (!to.Active) { throw new ValidationException("The " + to.Name + " queue is closed."); }
  var fromLevel = item.EscalationLevel;
  var toLevel = to.Level > fromLevel ? to.Level : fromLevel + 1;
  var holder = item.Assignee;
  item.Queue = to;
  item.EscalationLevel = toLevel;
  // SECURITY-INVARIANT(inbox-work-goes-only-to-who-may-hold-it) — the holder keeps it at the new level only when they may
  // hold it there (and the app wants that): an escalation into a restricted L3 never leaves it with an L1 agent.
  var keeps = holder != null && App.Setting<InboxSetup>().KeepHolderOnEscalation && MayHold(holder!, item);
  // A step from the holder to nobody says it is unheld (`InboxStepWords`).
  if (holder != null && !keeps) { item.Assignee = null; }
  if (item.OfferedTo != null) { SettleOffer(item, null); }
  new Escalation { Item = item, FromLevel = fromLevel, ToLevel = toLevel, FromQueue = from, ToQueue = to, By = by,
                   Why = why, Metric = metric, Moment = moment, At = DurableClock.UtcNow };
  var step = new Handover { Item = item, Step = NextStep(item), From = holder, To = item.Assignee, FromQueue = from, ToQueue = to,
                              Reason = HandoverReason.Escalated, By = by, Level = toLevel, Metric = metric, Moment = moment,
                              Detail = why, At = DurableClock.UtcNow };
  Raise(new ItemEscalated { Item = item, Step = StepOf(step) });
  if (item.Assignee == null) { Distribute(item, null); }
  if (holder != null && !keeps) { Refill(holder, item); }
}

/// The next priority up; Urgent stays Urgent.
WorkPriority Raised(WorkPriority p) {
  if (p == WorkPriority.Low) { return WorkPriority.Normal; }
  if (p == WorkPriority.Normal) { return WorkPriority.High; }
  return WorkPriority.Urgent;
}

/// What `item`'s policy does now that `metric` is at risk (or breached): each action once — the moment is recorded once
/// per clock cycle, and this runs only where it is recorded.
[SuppressWarning("cost-unbounded-read")]   // one policy's steps for one clock moment
void Escalations(WorkItem item, SlaMetric metric, SlaMoment moment) {
  if (item.Policy == null) { return; }
  // Whoever is told hears the same event as everybody else; each says it in its reader's words when it is read.
  var retarget = false;
  foreach (var e in SlaEscalation.Where(e => e.Policy == item.Policy && e.Metric == metric && e.When == moment)
      .Include(e => e.MoveTo).ToList()) {
    if (e.Action == SlaAction.TellHolder) {
      if (item.Assignee != null) {
        Raise(new PromiseToldToHolder { Item = item, Holder = item.Assignee!, About = NameAt(item.Assignee), Metric = metric, Moment = moment });
      }
    } else if (e.Action == SlaAction.TellLeads) {
      Raise(new PromiseToldToLeads { Item = item, Metric = metric, Moment = moment });
    } else if (e.Action == SlaAction.RaisePriority) {
      var was = item.Priority;
      var now = Raised(was);
      if (now != was) {
        item.Priority = now;
        Raise(new PriorityChanged { Item = item, WasPriority = was, Priority = now, Metric = metric, Moment = moment });
        retarget = true;
      }
    } else if (e.Action == SlaAction.Escalate) {
      if (item.Queue != null && item.Queue.EscalatesTo != null) {
        LevelUp(item, null, "", metric, moment);
        retarget = true;
      }
    } else if (e.Action == SlaAction.MoveTo && e.MoveTo != null) {
      if (item.Queue == null || item.Queue.Id != e.MoveTo.Id) {
        MoveTo(item, e.MoveTo!, null, true);
        retarget = true;
      }
    }
  }
  if (retarget) {
    TakePolicy(item);
    Workflow.Retarget();
  }
}
