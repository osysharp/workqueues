/// The settings pages draw, and an admin's change is saved by the save bar.
[Test(Desk)]
void the_inbox_settings_pages_draw_for_an_admin() {
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Ada);
  foreach (var page in new List<string> { "/settings/queues", "/settings/hours", "/settings/routing", "/settings/skills", "/settings/views" }) {
    Ui.Visit(page);
    Assert.OnPage(page);
  }
  // THE SECTIONS ARE ANNOUNCED: the kit's provider puts all six in the area, grouped, with no list
  // written by the app — and its pages sit in the app's settings frame.
  foreach (var section in new List<string> { "Queues", "Routing", "Skills", "Shared views", "SLA policies", "Business hours" }) {
    Assert.Visible(section, within: "Settings sections");
  }
  Assert.Before("Inbox", "Service");
  Ui.Visit("/settings/skills");
  Assert.Visible("Spanish");
  Assert.Visible("Mateo", within: "Who has Spanish");
  Ui.Shot("settings-skills-light");
  Ui.Visit("/settings/queues");
  Assert.Visible("3 working it", within: "Support");
  Ui.Click("Change Support");
  Assert.Visible("Who works it");
  Ui.Shot("settings-queues-light");
}

/// ⭐ A SAVED VIEW WITH THE APP'S OWN FILTER LISTS WHAT THE FILTER KEEPS — reached from another view, as a person
/// reaches it. The list asks the app's filter when a view's list mounts, so a list moved from one view to another must
/// mount afresh for the new view (its rows are keyed by view, not by place); otherwise the filter would never be asked for
/// the saved view and it would list nothing while the server's `AppFilteredBy` named its items.
[Test(Desk)]
void a_saved_view_with_the_apps_own_filter_lists_what_the_filter_keeps() {
  Guid view = Guid.Empty;
  runas (Ines) {
    Ask("Refund for invoice 77", body: "Please refund the second charge");
    Ask("Printer offline", body: "It will not print");
    var refunds = new InboxView { Name = "Refunds", Owner = PersonNamed("Ines"), AppFilter = "says:refund" };
    UnitOfWork.Commit();
    view = refunds.Id;
    Assert.Equal(1, AppFilteredBy(view).Count);
  }
  Ui.Viewport(1440, 900);
  Ui.SignInAs(Ines);
  // The list lives in the layout (model/pages.osy `PanesFrame`), so the second view is the SAME list handed a new one.
  Ui.Visit("/panes/open");
  Assert.Visible("Printer offline", within: "Work");
  Ui.Click("Refunds", within: "Saved views");
  Assert.OnPage("/panes/v-" + view);
  Assert.Visible("Refund for invoice 77", within: "Work");
  Assert.Hidden("Printer offline", within: "Work");
}
